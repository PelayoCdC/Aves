<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del icono adaptativo: un degradado de verdes de bosque, mas claro
    arriba a la izquierda, donde "da la luz". Es un vector y no un color plano
    para que el icono tenga algo de profundidad sin meter un PNG en el repo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF6A9A4F" />
                <item android:offset="1" android:color="#FF2F4A27" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
